.claude

# Python
__pycache__/
*.pyc

# OpenClaw plugin pack artifacts (staged by .openclaw/package.json prepack)
.openclaw/*.tgz
.openclaw/.skills.staged

# Runtime artifacts from the deploy flow — these carry live credentials
# (NGC_CLI_API_KEY, NVIDIA_API_KEY, etc.) and resolved compose state,
# so they must never be committed. Generated by dev-profile.sh / the
# vss-deploy-profile skill on every deploy.
**/generated.env*
deploy/docker/resolved.yml
deploy/docker/rag-secret.override.yml

# Environment files for incident-console (the real-secret carrier is
# incident-console/.env.local; dev-profile-incident/.env is a tracked
# placeholder template). Use the same blanket .env* convention as the rest
# of the repo (services/ui/.gitignore, services/ui/apps/nv-metropolis-bp-vss-ui/.gitignore).
deploy/docker/developer-profiles/dev-profile-incident/incident-console/.env*
!deploy/docker/developer-profiles/dev-profile-incident/incident-console/.env.example

*.log
*checkpoint.*
.orchestrator-artifacts/*

# Runtime artifacts generated by the search-profile stream-processing
# deploy (rendered from committed .tmpl files) and the infra sdrc runner
deploy/docker/data-dir/
deploy/docker/developer-profiles/dev-profile-search/sdrc/2d/configs/config.yml
deploy/docker/developer-profiles/dev-profile-search/sdrc/2d/configs/docker_cluster_config-streamprocessing.json
deploy/docker/services/infra/sdrc/.wdm-env/
deploy/docker/services/infra/sdrc/log/
*.log.[0-9]*
