#!/bin/sh
# Stock `git lfs install` shim, kept so LFS commit handling still runs when
# hooks execute from .githooks/ instead of .git/hooks/. Warns (instead of
# failing the commit) on machines without git-lfs.
command -v git-lfs >/dev/null 2>&1 || { echo >&2 "post-commit: git-lfs not found, skipping lfs post-commit"; exit 0; }
git lfs post-commit "$@"
