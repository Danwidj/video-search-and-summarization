{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.nvidia.com/vss/contracts/chat-contract-v1/chat_request.schema.json",
  "title": "ChatRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Optional conversation session identifier. Generated by server if omitted."
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant", "system"],
            "description": "Role of the message author."
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "Text content of the message."
          }
        },
        "required": ["role", "content"]
      },
      "description": "Sequential message history for multi-turn dialogue."
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["global", "incident"],
          "default": "global",
          "description": "Scope of the conversation: 'global' across all incidents, or 'incident' focused on a single incident."
        },
        "incident_id": {
          "type": ["string", "null"],
          "description": "Target incident identifier when scope is 'incident'."
        },
        "evidence_crop_ids": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          },
          "description": "Optional list of evidence item identifiers (e.g. I1, E1) for focused visual QA."
        }
      },
      "description": "Optional conversational context specifying scope, target incident, or evidence crops."
    }
  },
  "required": ["messages"]
}
