# =============================================================================
# VLM GATEWAY ENVIRONMENT CONFIGURATION
# =============================================================================
# This file documents every environment variable that vlm-gateway's own
# code (app.py) actually reads from .env.local.
#
# Usage: copy this file to .env.local and fill in real values.
#   cp .env .env.local
#
# Real secrets (API key) never go in a tracked file.
# The committed dev-profile-incident/.env is a placeholder template for the
# compose stack; this file is the vlm-gateway-specific copyable template
# for local dev.
#
# On the VM deploy, nothing reads .env files inside the container — the real
# values live in the ignored generated.env.local / generated.env.remote copy
# passed to docker compose --env-file, interpolated into the container via
# compose.yml environment: (see ../incident-plan/incident-plan-implementation-local.md
# and incident-plan-implementation-remote.md §2).

# =============================================================================
# UPSTREAM ENDPOINT CONFIGURATION
# =============================================================================

# OpenAI-compatible chat-completions base URL for the upstream NVIDIA-hosted
# endpoint. Real value: the team's switchyard endpoint.
# Default: https://switchyard-13doh4lsz.brevlab.com/v1
VLM_GATEWAY_BASE_URL=https://switchyard-13doh4lsz.brevlab.com/v1

# API key for the upstream endpoint. REQUIRED for the gateway to function.
# Obtain from the NVIDIA team managing the switchyard endpoint.
# REAL SECRET - NEVER COMMIT A REAL VALUE HERE. Fill in .env.local only.
VLM_GATEWAY_API_KEY=

# =============================================================================
# LOCAL SERVER CONFIGURATION
# =============================================================================

# Host port the gateway listens on (default 8600 - verified free against
# 8000/8501/8900/30081/30082/7777/10000).
VLM_GATEWAY_PORT=8600