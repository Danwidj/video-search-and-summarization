# Laptop: cp .env .env.local        VM checkout: cp .env .env.remote
# Fill in section 1 for your machine. Never put a real value in this committed file.
# A setting is defined above the settings that refer to it, because the VM sources this file.

# =============================================================================
# 1. Fill these in
# =============================================================================

# Both machines: Supabase
INCIDENT_SUPABASE_URL=
INCIDENT_SUPABASE_SERVICE_ROLE_KEY=
INCIDENT_DB_DSN=

# Both machines: Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Laptop only: the VM to reach
VSS_SSH_HOST=

# VM only: keys
NGC_CLI_API_KEY=
OPENAI_API_KEY=

# VM only: models (bare base URL, no /v1)
LLM_BASE_URL=
LLM_NAME=
VLM_NAME=

# =============================================================================
# 2. Defaults (optional settings may stay blank)
# =============================================================================

# Deployment
MODE=2d
BP_PROFILE=bp_developer_search
HARDWARE_PROFILE=H100
NIM_MODEL_SIZE=nano
COMPOSE_PROJECT_NAME=mdx

# Blank: the VM scripts fill them in (this VM's address, this checkout's deploy/docker, <checkout>/.data)
HOST_IP=
VSS_APPS_DIR=
VSS_DATA_DIR=

# Optional. The console has its own model default (VLM_MODEL). The laptop needs the gateway pair only for mock mode and eval/; the VM agent reads it only as an override of VLM_BASE_URL and OPENAI_API_KEY
VLM_MODEL=
VLM_GATEWAY_BASE_URL=
VLM_GATEWAY_API_KEY=

# Compose still needs this path to load, although the SDR controller is scaled to 0
SDR_CONTROLLER_CONFIG_PATH=${VSS_APPS_DIR}/developer-profiles/dev-profile-search/sdrc/${MODE}

# GPU (only GPU 0 is used, GPU 1 belongs to another user)
CUDA_VISIBLE_DEVICES='0'
NVIDIA_VISIBLE_DEVICES='0'
RT_CV_DEVICE_ID='0'
LLM_DEVICE_ID='0'
VLM_DEVICE_ID='0'

# Models
LLM_MODE=remote
VLM_MODE=remote
LLM_NAME_SLUG=none
VLM_NAME_SLUG=none
COMPOSE_PROFILES=${BP_PROFILE}_${MODE},llm_${LLM_MODE}_${LLM_NAME_SLUG},vlm_${VLM_MODE}_${VLM_NAME_SLUG}
LLM_MODEL_TYPE=openai
VLM_MODEL_TYPE=openai
VLM_BASE_URL=${LLM_BASE_URL}
NVIDIA_API_KEY=${NGC_CLI_API_KEY}
LLM_PORT=30081
VLM_PORT=30082
VLM_NIM_KVCACHE_PERCENT="0.7"

# Agent (keep VSS_AGENT_HOST on loopback: the agent has no authentication)
VSS_AGENT_VERSION=3.2.1
VSS_AGENT_CONFIG_FILE=./deploy/docker/developer-profiles/dev-profile-base/vss-agent/configs/config.yml
VSS_AGENT_HOST=127.0.0.1
VSS_AGENT_PORT=8000
INCIDENT_AGENT_BASE_URL=http://localhost:8000
VSS_AGENT_OBJECT_STORE_TYPE=local_object_store
ENABLE_AUDIO=false
REPORT_REFERENCE_BASE_DIR=/tmp
# Blank means no cap on images per VLM call
VLM_MAX_IMAGES_PER_CALL=

# URLs
EXTERNAL_IP=localhost
HAPROXY_PORT=7777
VSS_PUBLIC_HTTP_PROTOCOL=http
VSS_PUBLIC_HOST=${EXTERNAL_IP}
VSS_PUBLIC_PORT=${HAPROXY_PORT}
VST_PORT=30888
VST_EXTERNAL_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}
VST_INTERNAL_URL=http://${HOST_IP}:${VST_PORT}
VSS_AGENT_REPORTS_BASE_URL=${VST_EXTERNAL_URL}/static/
PHOENIX_ENDPOINT=http://${HOST_IP}:6006
STREAM_PROCESSOR_HTTP_PORT=30001

# Telemetry
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORTER=otlp

# Elasticsearch and Kafka
STREAM_TYPE=kafka
ELASTICSEARCH_ILM_MIN_AGE=48h
ELASTICSEARCH_CONNECTION_MAX_ATTEMPTS=20
ELASTICSEARCH_RTVI_CV_EMBEDDINGS_DIM=1152
ELASTICSEARCH_VISION_LLM_EMBEDDINGS_DIM=768

# Perception and nvstreamer
PERCEPTION_IMAGE="nvcr.io/nvidia/vss-core/vss-rt-cv"
PERCEPTION_TAG="3.2.1"
NVSTREAMER_IMAGE_TAG="3.2.1"
NVSTREAMER_INSTALL_ADDITIONAL_PACKAGES=true
RTVI_CV_PORT=9000
RTVI_EMBED_MODEL=cosmos-embed1-448p-anomaly-detection
RTVI_EMBED_PORT=8017

# Caption pass
INCIDENT_CHUNKING_ENABLED=1
INCIDENT_CHUNK_WINDOW_SECONDS=20
INCIDENT_CHUNK_OVERLAP_SECONDS=2

# Person tracking
INCIDENT_TRACKING_ENABLED=true
INCIDENT_OBJECT_TRACKING_ENABLED=1
INCIDENT_OBJECT_TRACKING_MAX_DETECTOR_CALLS=80
INCIDENT_OBJECT_TRACKING_MAX_SECONDS=120
INCIDENT_ANALYSIS_BUDGET_SECONDS=540
NVSTREAMER_BASE_URL=http://localhost:31000
PERCEPTION_PROVISION_URL=http://localhost:9000
VIDEO_ANALYTICS_API_URL=http://localhost:8081
