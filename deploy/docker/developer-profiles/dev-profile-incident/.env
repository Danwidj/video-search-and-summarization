# =============================================================================
# DEV-PROFILE-INCIDENT ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains environment variables for the incident search & reporting
# developer profile. Reuses bp_developer_search's compose tag — see
# .docs/action-plan.md.
# Services: Foundational, VST, Remote LLM/VLM, RTVI, Agents
#
# Profile variants:
# 2d:
#   bp_developer_search
# =============================================================================

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# These variables control which services are deployed
# User should modify these based on deployment requirements

# Deployment mode: 2d
MODE=2d

# Blueprint profile: bp_developer_search
BP_PROFILE=bp_developer_search

# Hardware profile for NIM configuration optimization
# Valid values: H100, L40S, RTXPRO4500BW, RTXPRO6000BW, DGX-SPARK, IGX-THOR, AGX-THOR, OTHER
# Unused under remote mode (right-sizes local NIM containers only) — kept for reference.
# HARDWARE_PROFILE=H100

RESERVED_DEVICE_IDS='0'
FIXED_SHARED_DEVICE_IDS='1'
RT_CV_DEVICE_ID='0'
RT_EMBED_DEVICE_ID='1'
# GPU device IDs for LLM/VLM — unused under remote mode (harmless if left set).
# LLM_DEVICE_ID='1'
# VLM_DEVICE_ID='2'

# LLM_MODE and VLM_MODE for deployment: local_shared, local, or remote
# For local_shared: requires NGC_CLI_API_KEY, runs LLM and VLM on single GPU
# For local: requires NGC_CLI_API_KEY
# For remote: requires LLM_BASE_URL and VLM_BASE_URL to be configured
LLM_MODE=remote
VLM_MODE=remote

# LLM options (remote mode on Brev endpoint — verified 2026-09-25, see .docs/architecture.md §3):
# - LLM_NAME: nvidia/nemotron-3-ultra (supports tool calling and structured json_schema output)
# - LLM_NAME: nvidia/nemotron-3-super-120b-a12b (fallback text model)
LLM_NAME=nvidia/nemotron-3-ultra
LLM_NAME_SLUG=none
LLM_ENV_FILE=''
LLM_BASE_URL=https://switchyard-13doh4lsz.brevlab.com
LLM_MODEL_TYPE=openai

# VLM options (remote mode on Brev endpoint — verified 2026-09-25, see .docs/architecture.md §3):
# - VLM_NAME: nvidia/cosmos-3-super-reasoner (supports base64 MP4 video_url inlining and JPEG frames)
# - VLM_NAME: nvidia/cosmos-3-nano-reasoner (lightweight VLM alternative)
VLM_NAME=nvidia/cosmos-3-super-reasoner
VLM_NAME_SLUG=none
VLM_ENV_FILE=''
VLM_BASE_URL=https://switchyard-13doh4lsz.brevlab.com
VLM_MODEL_TYPE=openai

# Endpoint URLs (required alongside --use-remote-llm / --use-remote-vlm).
# Both BASE_URL and ENDPOINT_URL are required — they serve distinct purposes in the agent config.
LLM_ENDPOINT_URL=https://switchyard-13doh4lsz.brevlab.com
VLM_ENDPOINT_URL=https://switchyard-13doh4lsz.brevlab.com

# Cosmos3 Reasoner only: selects model size (nano or super)
# Unused under remote mode (NIM-container-only setting).
# NIM_MODEL_SIZE=nano

# Computed compose profiles (DO NOT MODIFY)
COMPOSE_PROFILES=${BP_PROFILE}_${MODE},llm_${LLM_MODE}_${LLM_NAME_SLUG},vlm_${VLM_MODE}_${VLM_NAME_SLUG}

# OpenTelemetry Configuration
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORTER=otlp

# =============================================================================
# CORE INFRASTRUCTURE PATHS
# =============================================================================
# Used by: Foundational services, VST, NIM, RTVI, Agents
# User MUST modify these paths

# Path to deployments directory
VSS_APPS_DIR="/path/to/deploy/docker"

# Path to data directory (for models, videos, data logs)
VSS_DATA_DIR="/path/to/vss-apps-data"

# Host IP address for networking
HOST_IP='<HOST_IP>'
EXTERNAL_IP="${HOST_IP}"

# HAProxy ingress
HAPROXY_PORT=7777
VSS_PUBLIC_HTTP_PROTOCOL=http
VSS_PUBLIC_WS_PROTOCOL=ws
VSS_PUBLIC_HOST=${EXTERNAL_IP}
VSS_PUBLIC_PORT=${HAPROXY_PORT}

# =============================================================================
# API KEYS & CREDENTIALS
# =============================================================================

# NGC CLI API Key (REQUIRED for local LLM / VLM deployment)
# Obtain from: https://ngc.nvidia.com/
NGC_CLI_API_KEY=''

# NVIDIA API Key (REQUIRED for build.nvidia.com remote LLM / VLM endpoints)
# Obtain from: https://build.nvidia.com/
NVIDIA_API_KEY=''

# OPENAI API Key (REQUIRED for openai remote LLM / VLM endpoints).
# In remote mode on Brev, this is the Brev API key shared across LLM, VLM, and eval judge.
# Keep as placeholder here; real value goes in untracked generated.env.remote / .env.local.
OPENAI_API_KEY=''

# =============================================================================
# ELASTICSEARCH CONFIGURATION
# =============================================================================

# Elasticsearch ILM policy retention period (extended for search/embeddings)
ELASTICSEARCH_ILM_MIN_AGE=48h

# Maximum number of attempts to connect to Elasticsearch
ELASTICSEARCH_CONNECTION_MAX_ATTEMPTS=20

# Elasticsearch dense vector embedding dimensions
ELASTICSEARCH_RTVI_CV_EMBEDDINGS_DIM=1152   #1536 for radio-clip v1.0
ELASTICSEARCH_VISION_LLM_EMBEDDINGS_DIM=768
# =============================================================================
# MESSAGE BROKER CONFIGURATION
# =============================================================================
# Used by: Foundational services, VST

# Message broker type: kafka or redis
STREAM_TYPE=kafka

# Vision encoder model for search perception.
# Downloaded by the perception-2d-init container via NGC CLI.
# Convention (hardcoded org=nvidia, team=tao):
#   NGC model:  nvidia/tao/{MODEL}:deployable_{VERSION}
#   ONNX file:  {MODEL}_{VERSION}.onnx
#   Weights:    {MODEL}_{VERSION}_weights.bin
#   Tokenizer:  {MODEL}_{VERSION}_tokenizer
#   DS name:    {MODEL}-onnx
VISION_ENCODER_MODEL=siglip_v2
VISION_ENCODER_VERSION=v1.1

# Perception container image and tag
PERCEPTION_IMAGE="nvcr.io/nvidia/vss-core/vss-rt-cv"
# For multi-arch: 3.2.1
PERCEPTION_TAG="3.2.1"
# For DGX-SPARK (SBSA): 3.2.1-sbsa. Uncomment below and comment above
# PERCEPTION_TAG="3.2.1-sbsa"

# Number of concurrent streams to process
NUM_STREAMS=16

# =============================================================================
# NVSTREAMER CONFIGURATION
# =============================================================================
# Used by: nvstreamer-2d

# Install additional packages for audio, software encoding, file upload
NVSTREAMER_INSTALL_ADDITIONAL_PACKAGES=true

# Nvstreamer HTTP port
NVSTREAMER_HTTP_PORT=31000

# =============================================================================
# VIDEO ANALYTICS SERVICES CONFIGURATION
# =============================================================================
# Used by: video-analytics-ui, video-analytics-api

# Video Analytics UI port
UI_PORT=3002
VIDEO_ANALYTICS_UI_APP_NAME=sd

# Computed endpoints (DO NOT MODIFY)
MEDIA_SERVICE_ENDPOINT="${HOST_IP}"
REACT_APP_API_ENDPOINT_BASE_URL="${HOST_IP}:8081"
# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================

# Project name for volume naming (DO NOT MODIFY)
COMPOSE_PROJECT_NAME=mdx

# =============================================================================
# VLM-AS-VERIFIER CONFIGURATION
# =============================================================================
# Used by: alert-bridge service


# =============================================================================
# VLM GATEWAY CONFIGURATION
# =============================================================================
# Used by: vlm-gateway proxy service (incident-console, incident-console-v2 consumers)

# NVIDIA-hosted OpenAI-compatible endpoint base URL for the gateway upstream.
# Real value: the team's switchyard endpoint.
VLM_GATEWAY_BASE_URL=

# API key for the upstream endpoint. REAL SECRET - filled in generated.env.remote at deploy time.
VLM_GATEWAY_API_KEY=

# =============================================================================
# NIM CONFIGURATION
# =============================================================================
# Used by: vss-agent

# LLM Configuration
LLM_PORT=30081

# VLM Configuration
VLM_PORT=30082

VLM_NIM_KVCACHE_PERCENT="0.7"
# Custom model weights (local path only — used as a bind mount source).
# VLM_CUSTOM_WEIGHTS=""

# Optional model override for the cosmos3-reasoner NIM (an NGC ngc:// ref or a
# local custom-weights path). Left empty so the NIM uses its built-in manifest;
# the BF16 profile is pinned via NIM_MODEL_PROFILE in
# deploy/docker/services/nim/cosmos3-reasoner/hw-${HARDWARE_PROFILE}[-shared].env.
VLM_NIM_MODEL_NAME=

# =============================================================================
# VSS AGENT CONFIGURATION
# =============================================================================
# Used by: vss-agent, vss-va-mcp, vss-ui

# VSS Agent Core
VSS_AGENT_VERSION=3.2.1
VSS_AGENT_CONFIG_FILE=./deploy/docker/developer-profiles/dev-profile-base/vss-agent/configs/config.yml
VSS_AGENT_HOST=0.0.0.0
VSS_AGENT_PORT=8000
# Nemotron Nano Omni: set true so VST clip URLs and ingest keep audio (see vss-agent config enable_audio).
ENABLE_AUDIO=false

# RTVI Embed
RTVI_EMBED_IMAGE=nvcr.io/nvidia/vss-core/vss-rt-embed
RTVI_EMBED_TAG=3.2.1
RTVI_EMBED_MODEL=cosmos-embed1-448p-anomaly-detection
MODEL_PATH=git:https://huggingface.co/nvidia/Cosmos-Embed1-448p-anomaly-detection
RTVI_EMBED_PORT=8017
RTVI_CV_PORT=9000

# HuggingFace token for rt-embed's MODEL_PATH download. Optional — fill in
# (https://huggingface.co/settings/tokens) for faster first-run download of
# the Cosmos-Embed1 model. Anonymous downloads work but are noticeably slower.
HF_TOKEN=

# =============================================================================
# VST (VIDEO STORAGE TOOL) CONFIGURATION
# =============================================================================
# Used by: vss-agent, vss-ui

# VST Base Configuration
VST_PORT=30888
VST_EXTERNAL_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}
VST_INTERNAL_URL=http://${HOST_IP}:${VST_PORT}

# VST Image tags for common all platforms
VST_STREAM_PROCESSOR_IMAGE_TAG="3.2.1"
VST_SENSOR_IMAGE_TAG="3.2.1"
NVSTREAMER_IMAGE_TAG="3.2.1"
VST_INGRESS_IMAGE_TAG="3.2.1"

# =============================================================================
# AGENT STORAGE & REPORT CONFIGURATION
# =============================================================================
# Used by: vss-agent

VSS_ES_PORT=9200

# Object store type: local_object_store (in-memory, not persisted) or s3
VSS_AGENT_OBJECT_STORE_TYPE=local_object_store

# Base URL for report access
VSS_AGENT_REPORTS_BASE_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}/static/
VSS_AGENT_EXTERNAL_URL=${VSS_PUBLIC_HTTP_PROTOCOL}://${VSS_PUBLIC_HOST}:${VSS_PUBLIC_PORT}

# =============================================================================
# PHOENIX TELEMETRY CONFIGURATION
# =============================================================================
# Used by: vss-agent

PHOENIX_ENDPOINT=http://${HOST_IP}:6006

# =============================================================================
# VSS-UI SERVICE CONFIGURATION
# deploy/docker/services/ui/compose.yml — services.vss-ui (container_name: vss-agent-ui)
# =============================================================================
# Used by: vss-ui

NEXT_PUBLIC_APP_TITLE="VSS BLUEPRINT"
NEXT_PUBLIC_APP_SUBTITLE="Vision (Search)"
NEXT_PUBLIC_ENABLE_CHAT_TAB=false
NEXT_PUBLIC_ENABLE_ALERTS_TAB=false
NEXT_PUBLIC_ENABLE_DASHBOARD_TAB=true
NEXT_PUBLIC_ENABLE_MAP_TAB=false
NEXT_PUBLIC_ENABLE_VIDEO_MANAGEMENT_TAB=true
NEXT_PUBLIC_VIDEO_MANAGEMENT_TAB_ADD_RTSP_ENABLE=true
NEXT_PUBLIC_VIDEO_MANAGEMENT_VIDEO_UPLOAD_ENABLE=true
NEXT_PUBLIC_ENABLE_SEARCH_TAB=true
NEXT_PUBLIC_SEARCH_TAB_MEDIA_WITH_OBJECTS_BBOX=false
NEXT_PUBLIC_ENABLE_CHAT_SIDEBAR=true
NEXT_PUBLIC_CHAT_SIDEBAR_OPEN_DEFAULT=true
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_UPLOAD_FILE_ENABLE=true
NEXT_PUBLIC_SIDEBAR_CHAT_WORKFLOW="VSS Agent"
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_API_CUSTOM_AGENT_PARAMS_JSON='{"params":[{"name":"search_source_type","label":"Search media source type","type":"select","default-value":"video_file","options":["video_file","rtsp"],"changeable":true,"tooltip-info":"Media Source type for Search Agent Query"},{"name":"use_critic","label":"Enable Critic","type":"boolean","default-value":true,"changeable":true,"tooltip-info":"Verify results with Critic Agent"}]}'


# =============================================================================
# COSMOS EMBED & ELASTICSEARCH CONFIGURATION
# =============================================================================
# Used by: embed_search function

# Cosmos Embed Port
COSMOS_EMBED_PORT=8017
COSMOS_EMBED_ENDPOINT=http://${HOST_IP}:${COSMOS_EMBED_PORT}

# ElasticSearch Configuration
ELASTIC_SEARCH_PORT=9200
ELASTIC_SEARCH_ENDPOINT=http://${HOST_IP}:${ELASTIC_SEARCH_PORT}
ELASTIC_SEARCH_INDEX=mdx-embed-filtered-2025-01-01

# =============================================================================
# EVALUATION LLM JUDGE CONFIGURATION
# =============================================================================
# Used by: eval_llm_judge

EVAL_LLM_JUDGE_NAME=${LLM_NAME}
EVAL_LLM_JUDGE_BASE_URL=${LLM_BASE_URL}

# =============================================================================
# EVAL CONFIGURATION
# =============================================================================

EVAL_DIR=deploy/docker/developer-profiles/dev-profile-search/eval/
DATASET_DIR=agent_eval/dataset/vss-devx-search
EVAL_OUTPUT_DIR=agent_eval/results

# =============================================================================
# SDR CONTROLLER CONFIGURATION
# =============================================================================
# Used by: sdr-controller

SDR_CONTROLLER_CONFIG_PATH=${VSS_APPS_DIR}/developer-profiles/dev-profile-search/sdrc/${MODE}
