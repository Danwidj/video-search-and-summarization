# =============================================================================
# INCIDENT-CONSOLE ENVIRONMENT CONFIGURATION
# =============================================================================
# This file documents every environment variable that incident-console's own
# code (config.py, r2_videos.py) actually reads from .env.local.
#
# Usage: copy this file to .env.local and fill in real values.
#   cp .env .env.local
#
# Real secrets (Supabase DSN, Cloudflare R2 keys) never go in a tracked file.
# The committed dev-profile-incident/.env is a placeholder template for the
# compose stack; this file is the incident-console-specific copyable template
# for local dev. config.py loads ../.env (the profile placeholder) explicitly,
# then .env.local (this file's target) with override=True.
#
# On the VM deploy, nothing reads .env files inside the container — the real
# values live in the ignored generated.env.local / generated.env.remote copy
# passed to docker compose --env-file, interpolated into the container via
# compose.yml environment: (see ../incident-plan/incident-plan-implementation-local.md
# and incident-plan-implementation-remote.md §2).

# =============================================================================
# POSTGRES (Supabase, direct SQLAlchemy DSN)
# =============================================================================

# Direct Postgres DSN (SQLAlchemy sync URL). Empty string disables all DB
# pages — the app still imports but renders only the "database not configured"
# state. Real value: the team's Postgres instance (Supabase session pooler,
# or the direct connection if your network has IPv6 — see README.md
# "Database connection" for why). Percent-encode reserved URL chars
# in the password (e.g. "@" → "%40"). One-time seed once set:
#   uv run python scripts/seed_supabase.py
INCIDENT_DB_DSN=

# Seconds a good database round trip lets a page run skip its health probe
# (config.py default 15; 0 probes every run). See README.md "Database
# connection" ("Health probe").
INCIDENT_DB_HEALTHCHECK_TTL_SECONDS=

# Max age in seconds of a pooled connection before it is replaced at checkout
# (config.py default 600; -1 never recycles). Tune with
# `scripts/db_timing.py --idle ...`; see README.md "Database connection".
INCIDENT_DB_POOL_RECYCLE_SECONDS=

# =============================================================================
# CLOUDFLARE R2 (video clips + evidence screenshots)
# =============================================================================
# r2_videos.py reads these directly; blank disables R2 listing/playback.
# Real values: the R2 bucket credentials (account ID, access key, secret key,
# bucket name). Obtain from the Cloudflare dashboard.

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# =============================================================================
# SUPABASE POSTGREST API (Agent-Side Database Helper / Mock Backend)
# =============================================================================
# Used by services/agent/src/vss_agents/utils/incident_db.py when testing the
# agent directly or running the local mock backend (local-start.sh) for report
# generation persistence. The agent uses PostgREST over HTTPS rather than direct
# Postgres wire protocol due to VM network constraints.
# Real values: Project URL and Service Role Key from Supabase Project Settings -> API.

INCIDENT_SUPABASE_URL=
INCIDENT_SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# VSS-AGENT API
# =============================================================================

# Base URL of vss-agent's upload + AI-trigger API (POST /api/v1/videos,
# POST /api/v1/incidents/{id}/analyze, POST /api/v1/search). Real value:
# the running vss-agent service (VSS_AGENT_PORT, default 8000). Under the
# Phase 4 SSH tunnel (../scripts/tunnel.sh) this stays http://localhost:8000.
INCIDENT_AGENT_BASE_URL=http://localhost:8000

# =============================================================================
# LLM / EMBEDDING ENDPOINTS
# =============================================================================

# OpenAI-compatible chat-completions base URL. Real value: mock_llm_server.py
# locally (http://localhost:8900/v1); the tunneled real NIM
# (http://localhost:30081/v1) under the Phase 4 tunnel; vss-agent's
# LLM_BASE_URL / a live NIM on the VM.
INCIDENT_LLM_BASE_URL=http://localhost:8900/v1

# OpenAI-compatible embeddings base URL used by matching.py. Real value: the
# platform's embedding endpoint. Unset means matching fails soft to no matches.
INCIDENT_EMBEDDING_BASE_URL=

# =============================================================================
# VIDEO PLAYBACK
# =============================================================================

# Optional explicit base URL that video playback (st.video) is served from —
# typically a public R2 URL prefix. When blank, playback falls back to R2
# presigned URLs built from the R2_* keys above; with neither set, the app
# shows the stored key and the incident window instead of a player.
INCIDENT_VIDEO_BASE_URL=

# =============================================================================
# NOTIFICATION / HTTP TUNING
# =============================================================================

# Severity ≥ this raises a notification on verify (config.py default 4).
# Proposed default from the incident plan, not spec-sourced — confirm with
# the team (incident-plan-implementation-shared.md §5).
INCIDENT_SEVERITY_NOTIFY_THRESHOLD=

# HTTP client timeout in seconds for agent/LLM/embedding calls
# (config.py http_timeout_seconds(), code default 15.0). Set only if the
# default is wrong for the deployment; VM value goes in the generated.env.*
# copy.
INCIDENT_HTTP_TIMEOUT_SECONDS=

# =============================================================================
# VM DEPLOY ONLY
# =============================================================================

# Host port the incident-console Streamlit server listens on in the VM deploy
# (compose maps it via STREAMLIT_SERVER_PORT, default 8501). Documented here
# so the name is discoverable; the tracked template keeps the default unset.
INCIDENT_CONSOLE_PORT=